{
  "extends": "./.wxt/tsconfig.json",
  "exclude": [
    "**/node_modules",
    ".output",
    ".worktrees",
    "desktop/dist",
    "desktop/src-tauri/target"
  ],
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "types": ["chrome", "node"],
    "skipLibCheck": true
  }
}
