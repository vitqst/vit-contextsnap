{
  "extends": "./.wxt/tsconfig.json",
  "exclude": ["**/node_modules", ".output", ".worktrees"],
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "noUncheckedIndexedAccess": true,
    "jsx": "react-jsx",
    "types": ["chrome", "node"],
    "skipLibCheck": true
  }
}
